# ==============================================================================
# Universal AI Agent Hub - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# The .env file is git-ignored and will NEVER be committed to GitHub.
# ==============================================================================

# Supabase Management API Personal Access Token
# Obtain from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your_token_here

# Vercel Personal Access Token
# Obtain from: https://vercel.com/account/tokens
VERCEL_TOKEN=vcp_your_token_here

# GitHub Personal Access Token (Classic with repo/read:packages scope)
# Obtain from: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here

# 21st.dev Magic API Key (Optional)
API_KEY_21ST=21st_sk_your_key_here

# Google Stitch API Key (Optional)
STITCH_API_KEY=AQ.your_key_here
